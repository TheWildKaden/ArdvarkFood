{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Pages Preview",
      "type": "shell",
      "command": "./scripts/preview-pages.sh",
      "isBackground": true,
      "problemMatcher": {
        "owner": "pages-preview",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Serving HTTP on",
          "endsPattern": "^Serving HTTP on"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    }
  ]
}
