{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start AI Buddy Dev Preview",
      "type": "shell",
      "command": "./scripts/start-dev-preview.sh",
      "isBackground": true,
      "problemMatcher": {
        "owner": "ai-buddy-preview",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Uvicorn running on",
          "endsPattern": "Application startup complete"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    }
  ]
}
