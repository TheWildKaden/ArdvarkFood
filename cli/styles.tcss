#body {
    height: 1fr;
}

#sidebar {
    width: 20;
    border-right: solid $primary;
}

#content {
    width: 1fr;
    height: 100%;
}

DashboardPane,
NotesPane,
SettingsPane,
MemoryPane,
LearningPane,
CompilerPane,
ModelsPane {
    height: 100%;
    padding: 1 2;
}

MemoryPane Static,
LearningPane Static,
CompilerPane Static,
ModelsPane Static {
    height: auto;
    margin-bottom: 1;
}

MemoryPane Horizontal,
LearningPane Horizontal,
CompilerPane Horizontal,
ModelsPane Horizontal {
    height: auto;
    margin-bottom: 1;
}

MemoryPane Input,
LearningPane Input,
CompilerPane Input,
ModelsPane Input {
    width: 1fr;
    margin-right: 1;
}

LearningPane #learning-status,
LearningPane #learning-examples,
CompilerPane #compiler-results,
ModelsPane #model-results,
MemoryPane #memory-results {
    height: 1fr;
    overflow-y: auto;
    border: round $primary;
    padding: 1;
}

LearningPane Button,
CompilerPane Button,
ModelsPane Button,
MemoryPane Button {
    margin-right: 1;
}

/* Dashboard */
#clock {
    text-style: bold;
    content-align: center middle;
    height: 3;
}

#sysinfo {
    color: $text-muted;
    content-align: center middle;
    height: 1;
}

/* Notes */
NotesPane Horizontal {
    height: 100%;
}

#notes-list-col {
    width: 30;
}

#notes-list {
    height: 1fr;
}

#notes-edit-col {
    width: 1fr;
    padding-left: 2;
}

#note-title {
    margin-bottom: 1;
}

#note-body {
    height: 1fr;
}

NotesPane Button {
    margin-top: 1;
    margin-right: 1;
}

/* Settings */
#settings-row {
    height: auto;
}

#settings-row Label {
    padding: 1 2 0 0;
}

#data-dir {
    margin-top: 1;
    color: $text-muted;
}
